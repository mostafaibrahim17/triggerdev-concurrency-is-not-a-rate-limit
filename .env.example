# Your project ref from the Trigger.dev dashboard (Project settings).
TRIGGER_PROJECT_REF=

# Dashboard -> your project -> API keys. Needed by the scripts in scripts/,
# which trigger runs through the SDK. The `trigger.dev dev` CLI does not use it.
TRIGGER_SECRET_KEY=

# Where the bundled mock vendor listens. Must match scripts/mock-api.ts.
MOCK_API_URL=http://localhost:7788

# Optional knobs on the mock vendor, defaults shown.
# RATE=5          requests per second it will serve
# BURST=5         token bucket size
# LATENCY_MS=600  added latency per call
